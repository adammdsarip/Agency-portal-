# ---------------------------------------------------------------
# Firebase web app config (Firebase console → Project settings → Your apps).
# These are public identifiers, not secrets: security is enforced by
# Firestore Security Rules, not by hiding this config.
# ---------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to "true" to use the local Auth + Firestore emulators (npm run emulators).
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# ---------------------------------------------------------------
# SERVER ONLY — Firebase Admin SDK service account
# (Project settings → Service accounts → Generate new private key).
# Never prefix these with NEXT_PUBLIC_. Keep the \n escapes in the key.
# ---------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
